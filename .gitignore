# Compiled class file
*.class

# Java build output
/out/
/build/
/target/

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

.idea/

# Skillora local application data - never publish student records
/data/*.txt
/src/data/
/.vscode/
.gitignore:34:/data/*.txt	data/students.txt
.gitignore:34:/data/*.txt	data/requests.txt
.gitignore:34:/data/*.txt	data/sessions.txt
.gitignore:35:/src/data/	src/data/students.txt
.gitignore:36:/.vscode/	.vscode/settings.jsoncat
